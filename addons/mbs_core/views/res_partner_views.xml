<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mbs_res_partner_form" model="ir.ui.view">
        <field name="name">res.partner.form.mbs.maroc</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='vat']" position="after">
                <field name="mbs_ice"/>
                <field name="mbs_if"/>
                <field name="mbs_rc"/>
                <field name="mbs_cnss"/>
            </xpath>
        </field>
    </record>
</odoo>
