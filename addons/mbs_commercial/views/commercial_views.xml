<odoo>
    <record id="mbs_sale_order_form" model="ir.ui.view">
        <field name="name">sale.order.form.mbs.controls</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Controle MBS">
                    <field name="mbs_control_state" readonly="1"/>
                    <field name="mbs_control_message" readonly="1" nolabel="1"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="mbs_purchase_order_form" model="ir.ui.view">
        <field name="name">purchase.order.form.mbs.controls</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Controle MBS">
                    <field name="mbs_control_state" readonly="1"/>
                    <field name="mbs_control_message" readonly="1" nolabel="1"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="action_mbs_sales_orders" model="ir.actions.act_window">
        <field name="name">Devis et commandes clients</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,kanban,form,pivot,graph</field>
    </record>

    <record id="action_mbs_sales_controls" model="ir.actions.act_window">
        <field name="name">Ventes a verifier</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form,pivot,graph</field>
        <field name="domain">[("mbs_control_state", "=", "warning")]</field>
    </record>

    <record id="action_mbs_purchase_orders" model="ir.actions.act_window">
        <field name="name">Commandes fournisseurs</field>
        <field name="res_model">purchase.order</field>
        <field name="view_mode">list,kanban,form,pivot,graph</field>
    </record>

    <record id="action_mbs_purchase_controls" model="ir.actions.act_window">
        <field name="name">Achats a verifier</field>
        <field name="res_model">purchase.order</field>
        <field name="view_mode">list,form,pivot,graph</field>
        <field name="domain">[("mbs_control_state", "=", "warning")]</field>
    </record>

    <record id="action_mbs_stock_pickings" model="ir.actions.act_window">
        <field name="name">Livraisons et receptions</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">list,kanban,form</field>
    </record>

    <record id="action_mbs_products" model="ir.actions.act_window">
        <field name="name">Produits et services</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <menuitem id="menu_mbs_commercial" name="Gestion commerciale" parent="mbs_core.menu_mbs_root" sequence="10"/>
    <menuitem id="menu_mbs_sales_orders" name="Ventes" parent="menu_mbs_commercial" action="action_mbs_sales_orders" sequence="10"/>
    <menuitem id="menu_mbs_sales_controls" name="Ventes a verifier" parent="menu_mbs_commercial" action="action_mbs_sales_controls" sequence="15"/>
    <menuitem id="menu_mbs_purchase_orders" name="Achats" parent="menu_mbs_commercial" action="action_mbs_purchase_orders" sequence="20"/>
    <menuitem id="menu_mbs_purchase_controls" name="Achats a verifier" parent="menu_mbs_commercial" action="action_mbs_purchase_controls" sequence="25"/>
    <menuitem id="menu_mbs_stock_pickings" name="Livraisons / Receptions" parent="menu_mbs_commercial" action="action_mbs_stock_pickings" sequence="30"/>
    <menuitem id="menu_mbs_products" name="Produits / Services" parent="menu_mbs_commercial" action="action_mbs_products" sequence="40"/>
</odoo>
